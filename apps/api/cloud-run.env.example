NODE_ENV=production

# API legado de autenticación. Cloud Run llena PORT automáticamente.
# No agregues configuración de renderizado aquí: la producción de video vive en
# las rutas Next de HyperFrames.
API_PUBLIC_URL=https://courseforge-api-xxxxx-uc.a.run.app
EXPRESS_PUBLIC_URL=https://courseforge-api-xxxxx-uc.a.run.app

# Keep origins explicit. Comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://courseforge.netlify.app,https://staging-courseforge.netlify.app

# Supabase secrets must be configured as Cloud Run secrets or encrypted env vars.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-manager-reference

