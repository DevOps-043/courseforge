{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".tmp/remotion-tests",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/domains/materials/types/materials.types.ts",
    "src/lib/client/slide-generation.ts",
    "src/lib/client/__tests__/**/*.ts",
    "src/domains/library/library-grouping.ts",
    "src/domains/library/library-normalizer.ts",
    "src/domains/library/types.ts",
    "src/domains/library/__tests__/**/*.ts",
    "src/remotion/assembly-assets.normalizer.ts",
    "src/remotion/buildAssemblyProps.ts",
    "src/remotion/template-config.ts",
    "src/domains/production/validation/bundle-validator.ts",
    "src/domains/production/validation/open-design-slide-test.service.ts",
    "src/domains/production/validation/__tests__/**/*.ts",
    "src/domains/production/bundle-agent/types.ts",
    "src/domains/production/bundle-agent/redaction.service.ts",
    "src/domains/production/bundle-agent/spec.service.ts",
    "src/domains/production/bundle-agent/generation.service.ts",
    "src/domains/production/bundle-agent/security-validator.ts",
    "src/domains/production/bundle-agent/__tests__/**/*.ts",
    "src/domains/production/render-batches/render-batch.types.ts",
    "src/domains/production/render-batches/__tests__/**/*.ts",
    "src/domains/production/jobs/production-jobs.service.ts",
    "src/domains/production/jobs/__tests__/**/*.ts",
    "src/domains/production/slides/**/*.ts",
    "src/domains/production/providers/credentials/**/*.ts",
    "src/domains/production/providers/heygen/heygen.types.ts",
    "src/domains/production/providers/heygen/heygen.validators.ts",
    "src/domains/production/providers/heygen/heygen.client.ts",
    "src/domains/production/providers/heygen/heygen.repository.ts",
    "src/domains/production/providers/heygen/heygen-normalizers.ts",
    "src/domains/production/providers/heygen/heygen-catalog.service.ts",
    "src/domains/production/providers/heygen/heygen-credential-resolver.service.ts",
    "src/domains/production/providers/heygen/__tests__/**/*.ts",
    "src/remotion/types.ts",
    "src/remotion/visual-timeline.ts",
    "src/remotion/components/slide-timeline-rendering.ts",
    "src/remotion/__tests__/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/remotion/**/*.tsx"
  ]
}
