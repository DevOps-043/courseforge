{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".tmp/security-boundaries-tests",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/domains/production/external-media-import-policy.ts",
    "src/domains/production/__tests__/external-media-import-policy.test.ts",
    "src/domains/production/providers/artlist.types.ts",
    "src/domains/production/providers/__tests__/artlist-types.test.ts",
    "src/domains/production/providers/google-picker-runtime.types.ts",
    "src/domains/production/providers/__tests__/google-picker-runtime.test.ts",
    "src/domains/production/animated-deck/animated-deck-appearance.service.ts",
    "src/domains/video-duration/video-duration-policy.ts",
    "src/domains/materials/validators/assets.validators.ts",
    "src/domains/materials/validators/__tests__/material-assets-contract.test.ts",
    "src/domains/scorm/services/scorm-parser.service.ts",
    "src/domains/scorm/services/__tests__/scorm-parser-security.test.ts",
    "src/domains/scorm/scorm-job-contracts.ts",
    "src/domains/scorm/__tests__/scorm-job-contracts.test.ts",
    "src/domains/scorm/types/**/*.ts",
    "src/lib/server/env.ts",
    "src/lib/server/outbound-http.ts",
    "src/lib/server/desktop-worker-job-contracts.ts",
    "src/lib/server/background-payload-signature.ts",
    "src/lib/server/__tests__/outbound-http.test.ts",
    "src/lib/server/__tests__/desktop-worker-job-contracts.test.ts",
    "src/lib/server/__tests__/background-payload-signature.test.ts",
    "src/lib/server/__tests__/privileged-background-inventory.test.ts"
  ],
  "exclude": ["node_modules"]
}
